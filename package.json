{
  "name": "pousada-coração-da-ilha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "tailwindcss -i ./tailwind.css -o ./generated.css --minify",
    "check": "tsc --noEmit && node scripts/check-build.mjs",
    "dev": "vite",
    "build": "tailwindcss -i ./tailwind.css -o ./generated.css --minify && vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
